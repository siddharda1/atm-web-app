import time
import random
import datetime

# ─────────────────────────────────────────
#  DATABASE (in-memory)
# ─────────────────────────────────────────
accounts = {
    "1234567890123456": {
        "pin": "1234",
        "name": "Rahul Sharma",
        "balance": 50000.00,
        "transactions": [],
        "blocked": False,
        "failed_attempts": 0,
    },
    "9876543210987654": {
        "pin": "5678",
        "name": "Priya Mehta",
        "balance": 120000.00,
        "transactions": [],
        "blocked": False,
        "failed_attempts": 0,
    },
}

MAX_FAILED_ATTEMPTS = 3
DAILY_WITHDRAWAL_LIMIT = 25000


# ─────────────────────────────────────────
#  DISPLAY HELPERS
# ─────────────────────────────────────────
def clear():
    print("\n" * 2)

def border():
    print("=" * 45)

def header(title="ATM MACHINE"):
    border()
    print(f"   🏦  {title.center(35)}")
    border()

def pause(msg="Processing", secs=1.5):
    print(f"\n  ⏳  {msg}", end="", flush=True)
    for _ in range(3):
        time.sleep(secs / 3)
        print(".", end="", flush=True)
    print()

def timestamp():
    return datetime.datetime.now().strftime("%d-%b-%Y %I:%M %p")

def generate_txn_id():
    return "TXN" + str(random.randint(100000, 999999))

def show_receipt(title, amount, balance, name):
    border()
    print("          🧾  TRANSACTION RECEIPT")
    border()
    print(f"  Date    : {timestamp()}")
    print(f"  Txn ID  : {generate_txn_id()}")
    print(f"  Account : {name}")
    print(f"  Type    : {title}")
    print(f"  Amount  : ₹ {amount:,.2f}")
    print(f"  Balance : ₹ {balance:,.2f}")
    border()


# ─────────────────────────────────────────
#  CARD VALIDATION & LOGIN
# ─────────────────────────────────────────
def insert_card():
    header("WELCOME")
    print("\n  Please enter your 16-digit Card Number.")
    print("  (Demo cards: 1234567890123456 / 9876543210987654)\n")
    card_number = input("  Card Number : ").strip().replace(" ", "")

    if card_number not in accounts:
        print("\n  ❌  Card not recognised. Please try again.")
        time.sleep(1.5)
        return None

    account = accounts[card_number]

    if account["blocked"]:
        print("\n  🚫  Your card is BLOCKED due to too many failed PIN attempts.")
        print("      Please visit your nearest branch.")
        time.sleep(2)
        return None

    return card_number


def verify_pin(card_number):
    account = accounts[card_number]

    for attempt in range(MAX_FAILED_ATTEMPTS):
        remaining = MAX_FAILED_ATTEMPTS - attempt
        pin = input(f"\n  Enter PIN ({remaining} attempt(s) left): ").strip()

        if pin == account["pin"]:
            account["failed_attempts"] = 0
            pause("Verifying PIN")
            print(f"\n  ✅  Welcome, {account['name']}!")
            time.sleep(1)
            return True
        else:
            account["failed_attempts"] += 1
            print("  ⚠️   Incorrect PIN.")

    account["blocked"] = True
    print("\n  🚫  Card BLOCKED after 3 failed attempts.")
    print("      Please contact your bank.")
    time.sleep(2)
    return False


# ─────────────────────────────────────────
#  ATM OPERATIONS
# ─────────────────────────────────────────
def check_balance(card_number):
    account = accounts[card_number]
    clear()
    header("BALANCE ENQUIRY")
    print(f"\n  Account Holder : {account['name']}")
    print(f"  Available Bal  : ₹ {account['balance']:,.2f}")
    print(f"  As of          : {timestamp()}")
    border()
    input("\n  Press ENTER to go back...")


def withdraw_cash(card_number):
    account = accounts[card_number]
    clear()
    header("CASH WITHDRAWAL")
    print("\n  Denominations available: ₹100 | ₹200 | ₹500 | ₹2000\n")

    try:
        amount = float(input("  Enter amount to withdraw: ₹ "))
    except ValueError:
        print("\n  ❌  Invalid amount entered.")
        time.sleep(1.5)
        return

    if amount <= 0:
        print("\n  ❌  Amount must be greater than zero.")
        time.sleep(1.5)
        return

    if amount % 100 != 0:
        print("\n  ❌  Amount must be in multiples of ₹100.")
        time.sleep(1.5)
        return

    if amount > DAILY_WITHDRAWAL_LIMIT:
        print(f"\n  ❌  Daily limit exceeded (Max: ₹{DAILY_WITHDRAWAL_LIMIT:,}).")
        time.sleep(1.5)
        return

    if amount > account["balance"]:
        print("\n  ❌  Insufficient balance.")
        time.sleep(1.5)
        return

    pause("Dispensing Cash")
    account["balance"] -= amount
    txn = {"type": "Withdrawal", "amount": amount, "date": timestamp()}
    account["transactions"].append(txn)

    show_receipt("Cash Withdrawal", amount, account["balance"], account["name"])
    print("\n  💵  Please collect your cash.")
    input("\n  Press ENTER to continue...")


def deposit_cash(card_number):
    account = accounts[card_number]
    clear()
    header("CASH DEPOSIT")

    try:
        amount = float(input("\n  Enter amount to deposit: ₹ "))
    except ValueError:
        print("\n  ❌  Invalid amount.")
        time.sleep(1.5)
        return

    if amount <= 0:
        print("\n  ❌  Amount must be greater than zero.")
        time.sleep(1.5)
        return

    pause("Counting Cash")
    account["balance"] += amount
    txn = {"type": "Deposit", "amount": amount, "date": timestamp()}
    account["transactions"].append(txn)

    show_receipt("Cash Deposit", amount, account["balance"], account["name"])
    input("\n  Press ENTER to continue...")


def fund_transfer(card_number):
    account = accounts[card_number]
    clear()
    header("FUND TRANSFER")

    beneficiary = input("\n  Enter beneficiary card number: ").strip()

    if beneficiary == card_number:
        print("\n  ❌  Cannot transfer to your own account.")
        time.sleep(1.5)
        return

    if beneficiary not in accounts:
        print("\n  ❌  Beneficiary account not found.")
        time.sleep(1.5)
        return

    bene_account = accounts[beneficiary]
    print(f"\n  Beneficiary : {bene_account['name']}")
    confirm = input("  Confirm? (y/n): ").strip().lower()
    if confirm != "y":
        print("\n  ❌  Transfer cancelled.")
        time.sleep(1)
        return

    try:
        amount = float(input("  Enter amount to transfer: ₹ "))
    except ValueError:
        print("\n  ❌  Invalid amount.")
        time.sleep(1.5)
        return

    if amount <= 0 or amount > account["balance"]:
        print("\n  ❌  Invalid amount or insufficient balance.")
        time.sleep(1.5)
        return

    pause("Processing Transfer")
    account["balance"] -= amount
    bene_account["balance"] += amount

    account["transactions"].append({"type": f"Transfer to {bene_account['name']}", "amount": -amount, "date": timestamp()})
    bene_account["transactions"].append({"type": f"Transfer from {account['name']}", "amount": amount, "date": timestamp()})

    show_receipt(f"Transfer → {bene_account['name']}", amount, account["balance"], account["name"])
    input("\n  Press ENTER to continue...")


def mini_statement(card_number):
    account = accounts[card_number]
    clear()
    header("MINI STATEMENT")
    txns = account["transactions"]

    if not txns:
        print("\n  No transactions found.")
    else:
        print(f"\n  Last {min(5, len(txns))} transaction(s):\n")
        for txn in txns[-5:]:
            symbol = "🟢" if txn["amount"] > 0 else "🔴"
            print(f"  {symbol} {txn['type']:<30} ₹{abs(txn['amount']):>10,.2f}")
            print(f"     📅 {txn['date']}")
            print()

    border()
    input("  Press ENTER to go back...")


def change_pin(card_number):
    account = accounts[card_number]
    clear()
    header("CHANGE PIN")

    old_pin = input("\n  Enter current PIN : ").strip()
    if old_pin != account["pin"]:
        print("\n  ❌  Incorrect current PIN.")
        time.sleep(1.5)
        return

    new_pin = input("  Enter new PIN     : ").strip()
    if len(new_pin) != 4 or not new_pin.isdigit():
        print("\n  ❌  PIN must be exactly 4 digits.")
        time.sleep(1.5)
        return

    confirm_pin = input("  Confirm new PIN   : ").strip()
    if new_pin != confirm_pin:
        print("\n  ❌  PINs do not match.")
        time.sleep(1.5)
        return

    pause("Updating PIN")
    account["pin"] = new_pin
    print("\n  ✅  PIN changed successfully!")
    time.sleep(1.5)


# ─────────────────────────────────────────
#  MAIN MENU
# ─────────────────────────────────────────
def main_menu(card_number):
    account = accounts[card_number]
    while True:
        clear()
        header("MAIN MENU")
        print(f"\n  Hello, {account['name'].split()[0]}! 👋")
        print("\n  1️⃣   Check Balance")
        print("  2️⃣   Withdraw Cash")
        print("  3️⃣   Deposit Cash")
        print("  4️⃣   Fund Transfer")
        print("  5️⃣   Mini Statement")
        print("  6️⃣   Change PIN")
        print("  7️⃣   Exit / Eject Card")
        border()

        choice = input("\n  Enter your choice (1-7): ").strip()

        if choice == "1":
            check_balance(card_number)
        elif choice == "2":
            withdraw_cash(card_number)
        elif choice == "3":
            deposit_cash(card_number)
        elif choice == "4":
            fund_transfer(card_number)
        elif choice == "5":
            mini_statement(card_number)
        elif choice == "6":
            change_pin(card_number)
        elif choice == "7":
            clear()
            print("\n  🏦  Thank you for using our ATM.")
            print("      Please take your card. Have a great day! 🙏")
            border()
            time.sleep(2)
            break
        else:
            print("\n  ❌  Invalid choice. Please select 1–7.")
            time.sleep(1.5)


# ─────────────────────────────────────────
#  ENTRY POINT
# ─────────────────────────────────────────
def run_atm():
    while True:
        clear()
        card_number = insert_card()

        if card_number is None:
            retry = input("\n  Try again? (y/n): ").strip().lower()
            if retry != "y":
                print("\n  Goodbye! 👋\n")
                break
            continue

        if verify_pin(card_number):
            main_menu(card_number)

        again = input("\n  Insert another card? (y/n): ").strip().lower()
        if again != "y":
            print("\n  Goodbye! 👋\n")
            break


if __name__ == "__main__":
    run_atm()
